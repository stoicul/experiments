{
  "name": "postgresql-search",
  "version": "1.0.0",
  "description": "PostgreSQL search benchmark comparing LIKE queries, regular indexes, and GIN trigram search.",
  "main": "index.ts",
  "scripts": {
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "docker-compose up --build benchmark",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down -v"
  },
  "keywords": [
    "postgresql",
    "pg_trgm",
    "search",
    "benchmark"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
